<section class="container py-5">
  <!-- Desktop 2x2 grid -->
  <div class="row g-3 d-none d-md-flex" style="height: 800px;"><!-- total height -->
    <!-- Left column (Block 1 + Block 3) -->
    <div class="col-md-6 d-flex flex-column">
      <div class="flex-grow-0" style="height: 40%;">
        {% if section.settings.block_1 %}
          <div class="text-center border rounded overflow-hidden h-100">
            <img src="{{ section.settings.block_1 | image_url: width: 800 }}" class="img-fluid w-100 h-100" style="object-fit: cover;">
          </div>
        {% else %}
          <div class="bg-light text-center border rounded h-100">No image selected</div>
        {% endif %}
      </div>
      <div class="flex-grow-0 mt-3" style="height: 60%;">
        {% if section.settings.block_3 %}
          <div class="text-center border rounded overflow-hidden h-100">
            <img src="{{ section.settings.block_3 | image_url: width: 800 }}" class="img-fluid w-100 h-100" style="object-fit: cover;">
          </div>
        {% else %}
          <div class="bg-light text-center border rounded h-100">No image selected</div>
        {% endif %}
      </div>
    </div>

    <!-- Right column (Block 2 + Block 4) -->
    <div class="col-md-6 d-flex flex-column">
      <div class="flex-grow-0" style="height: 60%;">
        {% if section.settings.block_2 %}
          <div class="text-center border rounded overflow-hidden h-100">
            <img src="{{ section.settings.block_2 | image_url: width: 800 }}" class="img-fluid w-100 h-100" style="object-fit: cover;">
          </div>
        {% else %}
          <div class="bg-light text-center border rounded h-100">No image selected</div>
        {% endif %}
      </div>
      <div class="flex-grow-0 mt-3" style="height: 40%;">
        {% if section.settings.block_4 %}
          <div class="text-center border rounded overflow-hidden h-100">
            <img src="{{ section.settings.block_4 | image_url: width: 800 }}" class="img-fluid w-100 h-100" style="object-fit: cover;">
          </div>
        {% else %}
          <div class="bg-light text-center border rounded h-100">No image selected</div>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Mobile layout: Block 1 full width, 2 & 3 scrollable row, 4 full width -->
  <div class="d-md-none">
    <!-- Block 1 full width -->
    <div class="mb-3">
      {% if section.settings.block_1 %}
        <div class="text-center border rounded overflow-hidden">
          <img src="{{ section.settings.block_1 | image_url: width: 800 }}" class="img-fluid" style="object-fit: cover; width: 100%; height: 400px;">
        </div>
      {% else %}
        <div class="bg-light text-center border rounded">No image selected</div>
      {% endif %}
    </div>

    <!-- Horizontal scroll for blocks 2 & 3 -->
    <div class="d-flex overflow-auto flex-nowrap mb-3" style="gap: 1rem; scroll-snap-type: x mandatory;">
      <div class="flex-shrink-0" style="width: 90vw; scroll-snap-align: start;">
        {% if section.settings.block_2 %}
          <div class="text-center border rounded overflow-hidden">
            <img src="{{ section.settings.block_2 | image_url: width: 800 }}" class="img-fluid" style="object-fit: cover; width: 100%; height: 400px;">
          </div>
        {% else %}
          <div class="bg-light text-center border rounded">No image selected</div>
        {% endif %}
      </div>
      <div class="flex-shrink-0" style="width: 90vw; scroll-snap-align: start;">
        {% if section.settings.block_3 %}
          <div class="text-center border rounded overflow-hidden">
            <img src="{{ section.settings.block_3 | image_url: width: 800 }}" class="img-fluid" style="object-fit: cover; width: 100%; height: 400px;">
          </div>
        {% else %}
          <div class="bg-light text-center border rounded">No image selected</div>
        {% endif %}
      </div>
    </div>

    <!-- Block 4 full width -->
    <div>
      {% if section.settings.block_4 %}
        <div class="text-center border rounded overflow-hidden">
          <img src="{{ section.settings.block_4 | image_url: width: 800 }}" class="img-fluid" style="object-fit: cover; width: 100%; height: 400px;">
        </div>
      {% else %}
        <div class="bg-light text-center border rounded">No image selected</div>
      {% endif %}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Fixed 4-Block Section",
  "settings": [
    { "type": "image_picker", "id": "block_1", "label": "Block 1 Image" },
    { "type": "image_picker", "id": "block_2", "label": "Block 2 Image" },
    { "type": "image_picker", "id": "block_3", "label": "Block 3 Image" },
    { "type": "image_picker", "id": "block_4", "label": "Block 4 Image" }
  ],
  "presets": [
    { "name": "Fixed 4-Block Section" }
  ]
}
{% endschema %}
