<section class="container py-5">
  <div class="row g-3">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'image_block' %}
          <div class="col-md-6">
            <div class="position-relative rounded overflow-hidden" style="height: 250px;">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | image_url: width: 800 }}" 
                     alt="{{ block.settings.image.alt | escape }}" 
                     class="w-100 h-100" style="object-fit: cover;">
              {% else %}
                <div class="bg-light w-100 h-100 d-flex align-items-center justify-content-center border">
                  <span class="text-muted">No image selected</span>
                </div>
              {% endif %}
            </div>
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Digifist",
  "class": "custom-section",
  "settings": [],
  "blocks": [
    {
      "type": "image_block",
      "name": "Image Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Upload image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "My custom section"
    }
  ]
}
{% endschema %}
