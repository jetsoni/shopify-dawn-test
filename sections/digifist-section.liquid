<section class="container py-5">

  {%- comment -%}
    Desktop layout: 2x2 grid with fixed height.
    Left column: Block 1 heading/button + Block 3 image.
    Right column: Block 2 image + floating featured product card + Block 4 heading/button.
  {%- endcomment -%}
  <div class="row g-5 d-none d-md-flex" style="height: 800px;">

    <!-- Left column -->
    <div class="col-md-6 d-flex flex-column">

      {%- comment -%}
        Block 1: Heading and optional button.
        Height: 40% of column.
      {%- endcomment -%}
      <div class="flex-grow-0 p-5" style="height: 40%;">
        {% if section.settings.block_1_heading %}
          <h3 style="font-size: x-large; font-weight:800;">
            {{ section.settings.block_1_heading | default: "You can define this text content in the section settings" }}
          </h3>
        {% endif %}
        {% if section.settings.block_1_button_text or section.settings.block_1_button_url %}
          <a href="{{ section.settings.block_1_button_url }}" class="btn btn-primary mt-2"
             style="text-decoration: none; text-transform: uppercase; color: #fff; padding: 1rem; background-color:black;">
            {{ section.settings.block_1_button_text | default: "[Button text]" }}
            <span class="ms-2 fs-1">&#8250;</span>
          </a>
        {% endif %}
      </div>

      {%- comment -%}
        Block 3: Image display with fallback if no image selected.
        Height: 60% of column.
      {%- endcomment -%}
      <div class="flex-grow-0 mt-3" style="height: 60%;">
        {% if section.settings.block_3 %}
          <div class="text-center border rounded overflow-hidden h-100">
            <img src="{{ section.settings.block_3 | image_url: width: 800 }}" class="img-fluid w-100 h-100" style="object-fit: cover;">
          </div>
        {% else %}
          <div class="bg-light text-center border rounded h-100">No image selected</div>
        {% endif %}
      </div>

    </div>

    <!-- Right column -->
    <div class="col-md-6 d-flex flex-column">

      {%- comment -%}
        Upper right: Block 2 image with optional floating featured product card.
        Height: 60% of column.
      {%- endcomment -%}
      <div class="position-relative flex-grow-0" style="height: 60%;">

        {% assign product = nil %}
        {% if section.settings.featured_product != blank %}
          {% assign product = all_products[section.settings.featured_product] %}
        {% endif %}

        {%- comment -%}
          Display floating featured product card if product exists.
          Display placeholder in Theme Editor if no product selected.
        {%- endcomment -%}
        {% if product %}
          <a href="{{ product.url }}" class="position-absolute bottom-0 end-0 mb-5 me-5 bg-light px-3 py-2 d-flex align-items-center shadow-sm text-decoration-none" style="z-index: 2;">
            <div class="me-3 text-start">
              <div class="fw-bold text-dark small">{{ product.title }}</div>
              <div class="text-muted small">{{ product.price | money }}</div>
            </div>
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 100 }}" alt="{{ product.title | escape }}" class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
            {% endif %}
          </a>
        {% elsif request.design_mode %}
          <div class="position-absolute bottom-0 end-0 mb-5 me-5 px-3 py-2 d-flex align-items-center justify-content-center shadow-sm"
               style="z-index: 2; border: 1px dashed #ccc; border-radius: 6px; min-width: 200px; min-height: 60px; color:#000; font-size: 0.875rem; background: rgba(255,255,255,0.5);">
            <span>Select product for this card in the section settings</span>
          </div>
        {% endif %}

        {%- comment -%}
          Block 2: Image with fallback if no image selected.
        {%- endcomment -%}
        {% if section.settings.block_2 %}
          <div class="text-center border rounded overflow-hidden h-100">
            <img src="{{ section.settings.block_2 | image_url: width: 800 }}" class="img-fluid w-100 h-100" style="object-fit: cover;">
          </div>
        {% else %}
          <div class="bg-light text-center border rounded h-100">No image selected</div>
        {% endif %}
      </div>

      {%- comment -%}
        Block 4: Heading and optional button.
        Height: 40% of column.
      {%- endcomment -%}
      <div class="flex-grow-0" style="height: 40%; padding: 8rem;">
        {% if section.settings.block_4_heading %}
          <h5 style="font-size: large; color:grey; font-weight: 200;">
            {{ section.settings.block_4_heading | default: "You can define this text content in the section settings" }}
          </h5>
        {% endif %}
        {% if section.settings.block_4_button_text or section.settings.block_4_button_url %}
          <a href="{{ section.settings.block_4_button_url }}" class="btn btn-primary mt-2"
             style="color: black; text-underline-offset: 8px;">
            {{ section.settings.block_4_button_text | default: "[Link text]" }}
          </a>
        {% endif %}
      </div>

    </div>

  </div>

  {%- comment -%}
    Mobile layout: stacked sections.
    Block 1 full width, Blocks 2 & 3 horizontally scrollable, Block 4 full width.
  {%- endcomment -%}
  <div class="d-md-none">

    {%- comment -%}
      Block 1: Heading and optional button.
    {%- endcomment -%}
    <div class="flex-grow-0 p-5" style="height: 40%;">
      {% if section.settings.block_1_heading %}
        <h3 style="font-size: x-large; font-weight:800;">
          {{ section.settings.block_1_heading | default: "You can define this text content in the section settings" }}
        </h3>
      {% endif %}
      {% if section.settings.block_1_button_text or section.settings.block_1_button_url %}
        <a href="{{ section.settings.block_1_button_url }}" class="btn btn-primary mt-2"
           style="text-decoration: none; text-transform: uppercase; color: #fff; padding: 1rem; background-color:black;">
          {{ section.settings.block_1_button_text | default: "[Button text]" }}
          <span class="ms-2 fs-1">&#8250;</span>
        </a>
      {% endif %}
    </div>

    {%- comment -%}
      Horizontal scroll for Blocks 2 & 3.
      Each block snaps into view using scroll-snap.
    {%- endcomment -%}
    <div class="d-flex overflow-auto flex-nowrap ms-5" style="gap: 1rem; scroll-snap-type: x mandatory;">

      <div class="flex-shrink-0" style="width: 90vw; scroll-snap-align: start;">
        {% if section.settings.featured_product %}
          {% assign product = section.settings.featured_product %}
          <a href="{{ product.url }}" class="position-absolute bg-light px-2 py-2 d-flex align-items-center shadow-sm text-decoration-none" style="z-index: 2; bottom: 0%; right: 6%; transform: translateY(80px);">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 100 }}" alt="{{ product.title | escape }}" class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
            {% endif %}
          </a>
        {% elsif request.design_mode %}
          <div class="position-absolute bottom-0 end-0 mb-5 me-5 px-3 py-2 d-flex align-items-center justify-content-center shadow-sm"
               style="z-index: 2; border: 1px dashed #ccc; border-radius: 6px; min-width: 200px; min-height: 60px; color:#000; font-size: 0.875rem; background: rgba(255,255,255,0.5);">
            <span>Select product for this card in the section settings</span>
          </div>
        {% endif %}

        {% if section.settings.block_2 %}
          <div class="text-center overflow-hidden">
            <img src="{{ section.settings.block_2 | image_url: width: 800 }}" class="img-fluid" style="object-fit: cover; width: 100%; height: 400px;">
          </div>
        {% else %}
          <div class="bg-light text-center border rounded">No image selected</div>
        {% endif %}
      </div>

      <div class="flex-shrink-0" style="width: 90vw; scroll-snap-align: start;">
        {% if section.settings.block_3 %}
          <div class="text-center overflow-hidden">
            <img src="{{ section.settings.block_3 | image_url: width: 800 }}" class="img-fluid" style="object-fit: cover; width: 100%; height: 400px;">
          </div>
        {% else %}
          <div class="bg-light text-center border rounded">No image selected</div>
        {% endif %}
      </div>

    </div>

    {%- comment -%}
      Block 4: Heading and optional button at full width.
    {%- endcomment -%}
    <div class="flex-grow-0 p-5" style="height: 40%;">
      {% if section.settings.block_4_heading %}
        <h5 style="font-size: large; color:grey; font-weight: 200;">
          {{ section.settings.block_4_heading | default: "You can define this text content in the section settings" }}
        </h5>
      {% endif %}
      {% if section.settings.block_4_button_text or section.settings.block_4_button_url %}
        <a href="{{ section.settings.block_4_button_url }}" class="btn btn-primary mt-2"
           style="color: black; text-underline-offset: 8px;">
          {{ section.settings.block_4_button_text | default: "[Link text]" }}
        </a>
      {% endif %}
    </div>

  </div>
</section>



{% schema %}
{
  "name": "Digifist section",
  "settings": [
    {
      "type": "header",
      "content": "Left column (desktop layout)"
    },
    {
      "type": "text",
      "id": "block_1_heading",
      "label": "Text content",
      "placeholder": "Add text content"
    },
    {
      "type": "text",
      "id": "block_1_button_text",
      "label": "Button text",
      "default": "Button text"
    },
    {
      "type": "url",
      "id": "block_1_button_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "block_3",
      "label": "Image (bottom left)"
    },

    {
      "type": "header",
      "content": "Right column (desktop layout)"
    },
    {
      "type": "image_picker",
      "id": "block_2",
      "label": "Image (top right)"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Select product for a floating product card"
    },
    {
      "type": "text",
      "id": "block_4_heading",
      "label": "Text content",
      "default": "Add text content"
    },
    {
      "type": "text",
      "id": "block_4_button_text",
      "label": "Link Text",
      "default": "Link text"
    },
    {
      "type": "url",
      "id": "block_4_button_url",
      "label": "Link URL"
    }
  ],
  "presets": [
    { "name": "Digifist section" }
  ]
}
{% endschema %}
